# Nebula Voice & Conversational Intelligence Platform - Environment Configuration

# Server & Client Ports
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Security & Authentication (JWT Secret >= 32 chars)
JWT_SECRET=nebula-voice-super-secret-jwt-key-minimum-32-chars-enterprise-2026!
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL URL e.g., postgresql://user:password@localhost:5432/nebulavoice)
# If left empty, Nebula Voice automatically operates on embedded local SQLite storage (nebula.db) with zero config!
DATABASE_URL=

# Google Gemini AI SDK (gemini-2.0-flash / gemini-1.5-flash)
# Get your API key at: https://aistudio.google.com/app/apikey
# If omitted, Nebula Voice operates on its built-in self-healing NLU conversational engine.
GEMINI_API_KEY=

# Sarvam AI Text-to-Speech (https://sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Rate Limiting & Performance Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
